{
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"outDir": "./out",
		"rootDir": ".",
		"target": "esnext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["bun"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": [".ladle/**/*.ts", ".ladle/**/*.tsx", "**/*.ts", "**/*.tsx", "**/*.mts", "**/*.mjs"],
	"exclude": ["node_modules", "out"]
}
