{
	"name": "@cmdniels/uikit",
	"version": "2.0.1",
	"private": false,
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./out/index.d.ts",
			"import": "./out/index.js"
		},
		"./cn": {
			"types": "./out/cn.d.ts",
			"import": "./out/cn.js"
		},
		"./tailwind.css": "./tailwind.css"
	},
	"main": "./out/index.js",
	"types": "./out/index.d.ts",
	"files": [
		"out",
		"tailwind.css",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun run build:clean && bun run build:tsc && bun run build:alias",
		"build:alias": "bunx tsc-alias -p tsconfig.build.json",
		"build:clean": "bunx rimraf out",
		"build:docs": "bunx ladle build",
		"build:tsc": "bunx tsc --project tsconfig.build.json",
		"dev": "bunx ladle serve",
		"fix": "bun run lint:fix && bun run format",
		"format": "bunx prettier --write .",
		"lint": "bunx eslint .",
		"lint:fix": "bunx eslint --fix .",
		"prepublishOnly": "bun run build",
		"preview": "bunx --bun ladle preview"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@tabler/icons-react": "^3.35.0",
		"@tailwindcss/postcss": "^4.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"motion": "^12.23.26",
		"react-day-picker": "^9.12.0",
		"sonner": "^2.0.7",
		"ssr-themes": "^0.3.4",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@cmdniels/eslint-config": "^1.2.1",
		"@ladle/react": "^5.1.1",
		"@types/bun": "*",
		"@types/node": "*",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"eslint": "*",
		"prettier": "*",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"tsc-alias": "^1.8.16",
		"typescript": "*",
		"vite": "^5.4.21"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"patchedDependencies": {
		"get-port@7.1.0": "patches/get-port@7.1.0.patch"
	}
}
